{
  "name": "@_linked/react",
  "version": "2.0.1",
  "packageManager": "npm@12.2.0",
  "license": "MIT",
  "linkedPackage": true,
  "type": "module",
  "description": "React bindings for @_linked/core",
  "sideEffects": [
    "./lib/esm/package.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/react.git"
  },
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "linked build",
    "compile": "echo '💫 Compiling ESM' && npx tsc -p tsconfig-esm.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest --config jest.config.cjs",
    "typecheck": "tsc -p tsconfig-test.json --noEmit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules npx jest --config jest.config.cjs react-component-integration --testPathIgnorePatterns=",
    "sync:agents": "node packages/semantu-agents/sync.mjs",
    "setup": "npx semantu-agents"
  },
  "peerDependencies": {
    "@_linked/core": "^2.27.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
    "@_linked/core": "^2.27.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@jest/globals": "^30.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.87.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.3"
  }
}
